
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planejamento Mini Mensa 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .mensa-blue { background-color: #002147; }
        .mensa-text { color: #002147; }
        .card-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="text-slate-800">

    <div id="app" class="min-h-screen flex flex-col">
        <!-- Header -->
        <header class="mensa-blue text-white py-6 px-4 shadow-lg">
            <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-center gap-4">
                <div class="flex items-center gap-4">
                    <div class="bg-white p-2 rounded-full">
                        <svg width="40" height="40" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M50 5L10 30V70L50 95L90 70V30L50 5Z" stroke="#002147" stroke-width="8"/>
                            <path d="M30 40L50 30L70 40V60L50 70L30 60V40Z" fill="#002147"/>
                        </svg>
                    </div>
                    <div>
                        <h1 class="text-2xl font-bold tracking-tight">Mini Mensa Brasil</h1>
                        <p class="text-blue-200 text-sm">Cronograma Educacional 2026 (Março - Dezembro)</p>
                    </div>
                </div>
                <div id="auth-status" class="text-xs bg-blue-900/50 px-3 py-1 rounded-full border border-blue-700">
                    Conectando ao sistema...
                </div>
            </div>
        </header>

        <main class="flex-grow max-w-6xl w-full mx-auto p-4 md:p-8">
            <!-- Introdução -->
            <section class="mb-8 bg-white p-6 rounded-2xl card-shadow border border-slate-100">
                <h2 class="text-xl font-semibold mensa-text mb-2">Painel de Planejamento</h2>
                <p class="text-slate-600">Bem-vindo ao portal de gestão da Mini Mensa. Professores podem selecionar qualquer sábado que esteja disponível (de Março a Dezembro) para propor temas e disponibilizar materiais.</p>
            </section>

            <!-- Filtros/Navegação Meses -->
            <div class="flex flex-wrap gap-2 mb-6 overflow-x-auto pb-2 scrollbar-hide" id="month-filters">
                <!-- Inserido via JS -->
            </div>

            <!-- Lista de Sábados -->
            <div id="calendar-container" class="grid gap-6">
                <div class="flex justify-center items-center py-20">
                    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-900"></div>
                </div>
            </div>
        </main>

        <!-- Modal de Proposta -->
        <div id="proposal-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
            <div class="bg-white rounded-2xl w-full max-w-md overflow-hidden shadow-2xl">
                <div class="mensa-blue p-4 text-white flex justify-between items-center">
                    <h3 class="font-bold">Propor Aula</h3>
                    <button id="close-modal-btn" class="hover:bg-blue-800 p-1 rounded">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <form id="proposal-form" class="p-6 space-y-4">
                    <input type="hidden" id="form-date">
                    <input type="hidden" id="form-slot">
                    
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Data e Horário</label>
                        <div id="modal-info" class="text-sm text-blue-800 font-semibold bg-blue-50 p-2 rounded"></div>
                    </div>

                    <div>
                        <label for="prof-name" class="block text-sm font-medium text-slate-700 mb-1">Nome do Professor</label>
                        <input type="text" id="prof-name" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-900 outline-none">
                    </div>

                    <div>
                        <label for="class-theme" class="block text-sm font-medium text-slate-700 mb-1">Tema da Aula</label>
                        <input type="text" id="class-theme" required class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-900 outline-none" placeholder="Ex: Astronomia, Lógica, IA...">
                    </div>

                    <div>
                        <label for="class-status" class="block text-sm font-medium text-slate-700 mb-1">Status da Aula</label>
                        <select id="class-status" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-900 outline-none bg-white">
                            <option value="open">Aberto para Alterações</option>
                            <option value="closed">Fechado para Edição</option>
                        </select>
                    </div>

                    <div>
                        <label for="class-desc" class="block text-sm font-medium text-slate-700 mb-1">Breve Descrição</label>
                        <textarea id="class-desc" rows="3" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-900 outline-none"></textarea>
                    </div>

                    <div>
                        <label for="class-link" class="block text-sm font-medium text-slate-700 mb-1">Link de Acesso/Material</label>
                        <input type="url" id="class-link" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-900 outline-none" placeholder="https://...">
                    </div>

                    <div class="pt-2">
                        <button type="submit" id="submit-btn" class="w-full mensa-blue text-white py-3 rounded-xl font-bold hover:opacity-90 transition-opacity">
                            Salvar Planejamento
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <footer class="bg-slate-200 py-6 text-center text-sm text-slate-500">
            &copy; 2026 Mini Mensa Brasil - Gestão Colaborativa
        </footer>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, onAuthStateChanged, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Configuração Firebase
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {};
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'mini-mensa-2026';
        
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let currentUser = null;
        let proposals = {};
        
        const currentMonth = new Date().getMonth();
        let selectedMonth = currentMonth < 2 ? 2 : currentMonth;

        const calendarContainer = document.getElementById('calendar-container');
        const authStatus = document.getElementById('auth-status');
        const proposalModal = document.getElementById('proposal-modal');
        const proposalForm = document.getElementById('proposal-form');
        const monthFilters = document.getElementById('month-filters');
        const closeModalBtn = document.getElementById('close-modal-btn');

        // Inicializar Auth
        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (error) {
                console.error("Erro na autenticação:", error);
                authStatus.textContent = "Erro de conexão";
            }
        };

        initAuth();

        onAuthStateChanged(auth, (user) => {
            if (user) {
                currentUser = user;
                authStatus.innerHTML = `Conectado: ${user.uid.substring(0,8)}...`;
                startDataListener();
            }
        });

        function startDataListener() {
            if (!currentUser) return;
            const proposalsRef = collection(db, 'artifacts', appId, 'public', 'data', 'proposals');
            
            onSnapshot(proposalsRef, (snapshot) => {
                proposals = {};
                snapshot.forEach(doc => {
                    proposals[doc.id] = doc.data();
                });
                renderCalendar();
            }, (error) => {
                console.error("Erro ao carregar dados:", error);
            });
        }

        function getAllSaturdays(year) {
            const saturdays = [];
            let date = new Date(year, 2, 1);
            while (date.getDay() !== 6) date.setDate(date.getDate() + 1);
            while (date.getFullYear() === year) {
                saturdays.push(new Date(date));
                date.setDate(date.getDate() + 7);
            }
            return saturdays;
        }

        const allSaturdays = getAllSaturdays(2026);
        const months = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];

        window.setMonth = (m) => {
            selectedMonth = m;
            renderMonthFilters();
            renderCalendar();
        };

        function renderMonthFilters() {
            monthFilters.innerHTML = months.map((month, idx) => {
                if (idx < 2) return ''; 
                return `
                    <button onclick="window.setMonth(${idx})" 
                        class="px-4 py-2 rounded-full text-sm font-medium transition-colors whitespace-nowrap
                        ${selectedMonth === idx ? 'mensa-blue text-white' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}">
                        ${month}
                    </button>
                `;
            }).join('');
        }

        function renderCalendar() {
            const filteredSaturdays = allSaturdays.filter(d => d.getMonth() === selectedMonth);
            
            if (filteredSaturdays.length === 0) {
                calendarContainer.innerHTML = `<p class="text-center py-10 text-slate-400">Nenhum sábado encontrado para este mês.</p>`;
                return;
            }

            calendarContainer.innerHTML = filteredSaturdays.map(date => {
                const dateStr = date.toISOString().split('T')[0];
                const day = date.getDate();
                const monthName = months[date.getMonth()];
                
                return `
                    <div class="bg-white rounded-2xl overflow-hidden card-shadow border border-slate-100">
                        <div class="bg-slate-50 px-6 py-3 border-b border-slate-100 flex justify-between items-center">
                            <span class="font-bold mensa-text text-lg">${day} de ${monthName}</span>
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Sábado</span>
                        </div>
                        <div class="p-0">
                            ${renderSlot(dateStr, "08:00 - 09:00", 1)}
                            <div class="border-t border-slate-50"></div>
                            ${renderSlot(dateStr, "09:00 - 10:00", 2)}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function renderSlot(dateStr, timeStr, slotId) {
            const proposalId = `${dateStr}_${slotId}`;
            const data = proposals[proposalId];
            const isClosed = data?.status === 'closed';

            if (data) {
                return `
                    <div class="p-4 md:p-6 flex flex-col md:flex-row gap-4 items-start md:items-center hover:bg-blue-50/30 transition-colors group">
                        <div class="${isClosed ? 'bg-red-100 text-red-900' : 'bg-blue-100 text-blue-900'} font-bold px-3 py-1 rounded text-sm w-full md:w-32 text-center">
                            ${timeStr}
                        </div>
                        <div class="flex-grow">
                            <div class="flex items-center gap-2">
                                <h4 class="font-bold text-slate-900 text-lg">${data.theme}</h4>
                                ${isClosed ? `
                                    <span class="flex items-center gap-1 bg-red-100 text-red-700 text-[10px] px-2 py-0.5 rounded-full font-bold uppercase">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                        </svg>
                                        Fechado
                                    </span>
                                ` : ''}
                            </div>
                            <p class="text-blue-700 font-medium text-sm">Prof. ${data.teacher}</p>
                            ${data.desc ? `<p class="text-slate-500 text-sm mt-1 italic">"${data.desc}"</p>` : ''}
                        </div>
                        <div class="flex gap-2 w-full md:w-auto">
                            ${data.link ? `
                                <a href="${data.link}" target="_blank" class="flex-1 md:flex-none text-center bg-emerald-500 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-emerald-600">
                                    Link
                                </a>
                            ` : ''}
                            <button onclick="window.openProposalModal('${dateStr}', '${slotId}', '${timeStr}')" class="flex-1 md:flex-none bg-slate-100 text-slate-600 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-slate-200">
                                Editar
                            </button>
                        </div>
                    </div>
                `;
            }

            return `
                <div class="p-4 md:p-6 flex flex-col md:flex-row gap-4 items-center group">
                    <div class="bg-slate-100 text-slate-400 font-bold px-3 py-1 rounded text-sm w-full md:w-32 text-center">
                        ${timeStr}
                    </div>
                    <div class="flex-grow text-slate-400 italic text-sm text-center md:text-left">
                        Disponível
                    </div>
                    <button onclick="window.openProposalModal('${dateStr}', '${slotId}', '${timeStr}')" 
                        class="w-full md:w-auto border-2 border-dashed border-slate-200 text-slate-400 px-6 py-2 rounded-xl text-sm font-bold hover:border-blue-900 hover:text-blue-900 transition-all">
                        + Propor
                    </button>
                </div>
            `;
        }

        window.openProposalModal = (date, slot, time) => {
            const proposalId = `${date}_${slot}`;
            const data = proposals[proposalId] || {};
            
            document.getElementById('form-date').value = date;
            document.getElementById('form-slot').value = slot;
            document.getElementById('modal-info').textContent = `${date.split('-').reverse().join('/')} às ${time}`;
            
            document.getElementById('prof-name').value = data.teacher || '';
            document.getElementById('class-theme').value = data.theme || '';
            document.getElementById('class-status').value = data.status || 'open';
            document.getElementById('class-desc').value = data.desc || '';
            document.getElementById('class-link').value = data.link || '';
            
            proposalModal.classList.remove('hidden');
        };

        window.closeModal = () => {
            proposalModal.classList.add('hidden');
        };

        closeModalBtn.onclick = closeModal;

        proposalForm.onsubmit = async (e) => {
            e.preventDefault();
            if (!currentUser) return;

            const date = document.getElementById('form-date').value;
            const slot = document.getElementById('form-slot').value;
            const proposalId = `${date}_${slot}`;

            const proposalData = {
                teacher: document.getElementById('prof-name').value,
                theme: document.getElementById('class-theme').value,
                status: document.getElementById('class-status').value,
                desc: document.getElementById('class-desc').value,
                link: document.getElementById('class-link').value,
                updatedAt: new Date().toISOString(),
                updatedBy: currentUser.uid
            };

            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.textContent = "Salvando...";

            try {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', 'proposals', proposalId);
                await setDoc(docRef, proposalData);
                closeModal();
            } catch (error) {
                console.error("Erro ao salvar:", error);
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = "Salvar Planejamento";
            }
        };

        window.onclick = (event) => {
            if (event.target == proposalModal) closeModal();
        };

        renderMonthFilters();
        renderCalendar();
    </script>
</body>
</html>
